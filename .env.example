CLIENT_ID=
# The token proxy (tool/token_proxy/README.md): the Cloudflare Worker that
# holds the Twitch client secret. https:// only. The secret itself never goes
# here.
TOKEN_PROXY_URL=
# Optional: Firebase (crash reports, analytics, performance). Leave empty
# to build without Firebase.
FIREBASE_API_KEY=
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_IOS=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
